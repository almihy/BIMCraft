msgstr "Clique no modelo: um ponto da sua superfície."

#: crates/ui-egui/src/lib.rs:5540
msgid "Click on the top: a point there, the Options Bar's offset over the surface, or at its Absolute elevation."
msgstr "Clique no topo: um ponto ali, no deslocamento da barra de opções sobre a superfície ou na elevação absoluta."

#: crates/ui-egui/src/draw.rs:611
msgid "Click one end of its axis."
msgstr "Clique numa extremidade do eixo."

#: crates/ui-egui/src/draw.rs:594
msgid "Click the arc's centre."
msgstr "Clique no centro do arco."

#: crates/ui-egui/src/lib.rs:5430
#: crates/ui-egui/src/lib.rs:5433
msgid "Click the centre of rotation."
msgstr "Clique no centro de rotação."

#: crates/ui-egui/src/draw.rs:586
msgid "Click the centre."
msgstr "Clique no centro."

#: crates/ui-egui/src/draw.rs:608
msgid "Click the ellipse's centre."
msgstr "Clique no centro da elipse."

